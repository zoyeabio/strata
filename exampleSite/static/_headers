# Deployment headers for Cloudflare Pages (also read by Netlify).
#
# Based on the theme's default static/_headers (security is the default),
# with the AdSense origins added so the [ads] loader can load once the
# site opts in. Site static/ wins over the theme's, so this file carries the
# complete policy — keep the security lines intact when you edit it.
#
# Why script-src lists the AdSense origins: the theme's js/ads.js injects
# https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js at grant
# time, and Google's ad runtime opens further ad/beacon/creative origins.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://pagead2.googlesyndication.com https://partner.googleadservices.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.google.com https://www.googlesyndication.com; font-src 'self'; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; frame-src 'self' https://www.google.com https://maps.google.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://tpc.googlesyndication.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
